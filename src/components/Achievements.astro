---
import { t, type Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const stats = [
  {
    value: '15+',
    label: { en: 'Years of Experience', zh: '年技术经验' },
  },
  {
    value: '96',
    label: { en: 'AI Agent Skills', zh: '个 Agent 技能' },
  },
  {
    value: '200+',
    label: { en: 'Engineers Served', zh: '名工程师服务' },
  },
  {
    value: '8',
    label: { en: 'BUs Unified on Test Strategy', zh: '个业务线统一测试策略' },
  },
];

const milestones = [
  {
    icon: '🌟',
    title: { en: 'Dell VP Star Award', zh: 'Dell VP 年度之星' },
    desc: {
      en: 'VP Star Award (2023) — led cross-BU integration testing for next-gen object storage across 8 business units, unifying test strategy and reducing release cycle from 7 to 5 days',
      zh: '2023 年 VP 年度之星 — 主导 8 个业务单元的下一代对象存储跨团队集成测试，统一测试策略，发布周期从 7 天缩短至 5 天',
    },
  },
  {
    icon: '🏆',
    title: { en: 'Dell Hackathon Champion', zh: 'Dell 黑客松冠军' },
    desc: {
      en: 'Dell Hackathon Champion (2025) — exceptional creativity and technical execution in company-wide innovation competition',
      zh: '2025 年公司级黑客松冠军，创意与技术落地获评委认可',
    },
  },
  {
    icon: '🎤',
    title: { en: 'QeCon Shanghai Speaker', zh: 'QeCon 上海大会讲师' },
    desc: {
      en: 'Delivered talk on Enterprise Platform Engineering Practices at QeCon Shanghai — China\'s premier software quality conference',
      zh: '在 QeCon 上海（国内顶级软件质量大会）做了「企业级平台工程实践」的主题演讲',
    },
  },
  {
    icon: '🤖',
    title: { en: 'Enterprise AI Agent Platform Founder', zh: '企业级 AI Agent 平台发起者' },
    desc: {
      en: 'Founded and architected a 96-skill enterprise AI agent platform with the Prompt-as-Orchestrator approach. Grew from a QA tool to cross-departmental adoption. 3-tier skill model, 4 invocation patterns, constitutional governance.',
      zh: '发起并架构设计 96 技能的企业级 AI Agent 平台，独创 Prompt-as-Orchestrator 架构，从 QA 工具发展为跨部门平台。三层技能模型、四种调用模式、宪法式治理。',
    },
  },
];

const career = [
  {
    period: '2022 – Present',
    role: { en: 'Senior Principal Engineer', zh: '资深首席工程师' },
    org: { en: 'Dell Technologies', zh: 'Dell Technologies' },
    highlight: { en: 'Founded 96-skill AI agent platform (Prompt-as-Orchestrator); cross-BU integration testing lead; VP Star Award; Hackathon Champion; QeCon speaker', zh: '发起 96 技能 AI Agent 平台（Prompt-as-Orchestrator 架构），牵头跨 BU 集成测试；VP 年度之星、黑客松冠军、QeCon 演讲嘉宾' },
  },
  {
    period: '2020 – 2022',
    role: { en: 'Head of Engineering', zh: '研发负责人' },
    org: { en: 'Banyumusic (Series A, SIG-led)', zh: '伴鱼音乐（A 轮，SIG 领投）' },
    highlight: { en: 'Led R&D team; drove AI piano coaching product from design to launch; competitive analysis & risk control', zh: '带领研发团队，推动 AI 钢琴陪练产品从设计到上线，负责竞品分析与风险把控' },
  },
  {
    period: '2017 – 2020',
    role: { en: 'Senior Architect', zh: '资深架构师' },
    org: { en: 'Dell EMC', zh: 'Dell EMC' },
    highlight: { en: 'Built automation frameworks for global teams (US/China/India); regression cycle -40%', zh: '给中美印三地团队搭自动化框架，回归测试周期缩短 40%' },
  },
  {
    period: '2016 – 2017',
    role: { en: 'Engineering Director', zh: '工程总监' },
    org: { en: 'Full Truck Alliance / YMM (NYSE: YMM)', zh: '满帮集团 / 运满满（纽交所: YMM）' },
    highlight: { en: 'Built 40-person team from zero; incidents -80%; deploy 3hrs → 15min', zh: '从零组建 40 人团队，线上事故减少 80%，发版时间从 3 小时缩短至 15 分钟' },
  },
  {
    period: '2010 – 2016',
    role: { en: 'Engineering Manager', zh: '工程经理' },
    org: { en: 'Dianping.com (now Meituan)', zh: '大众点评（现美团）' },
    highlight: { en: '17-person team; transaction, merchant & payment systems; millions of DAU; API framework with 90% browser-free testing', zh: '带 17 人团队，负责交易、商户和支付系统，百万日活；自研 API 测试框架，90% 测试脱离浏览器依赖' },
  },
  {
    period: '2009 – 2010',
    role: { en: 'Lead Engineer', zh: '主管工程师' },
    org: { en: 'Giant Interactive Group', zh: '巨人网络' },
    highlight: { en: 'SNS community platform & game portal, millions of DAU', zh: '做 SNS 社区和游戏门户，百万日活' },
  },
];
---

<section class="achievements-section" id="achievements">
  <div class="container">
    <div class="section-header">
      <h2>{t(lang, 'achievements.title')}</h2>
      <div class="divider"></div>
      <p>{t(lang, 'achievements.subtitle')}</p>
    </div>

    <!-- Stats -->
    <div class="stats-row">
      {stats.map((s) => (
        <div class="stat-item">
          <span class="stat-value">{s.value}</span>
          <span class="stat-label">{s.label[lang]}</span>
        </div>
      ))}
    </div>

    <!-- Career Timeline -->
    <div class="career-timeline">
      {career.map((c, i) => (
        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            <span class="timeline-period">{c.period}</span>
            <h3>{c.role[lang]}</h3>
            <p class="timeline-org">{c.org[lang]}</p>
            <p class="timeline-highlight">{c.highlight[lang]}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Milestones -->
    <div class="milestones-grid">
      {milestones.map((m) => (
        <div class="milestone-card">
          <span class="milestone-icon">{m.icon}</span>
          <h3>{m.title[lang]}</h3>
          <p>{m.desc[lang]}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .achievements-section {
    background: var(--color-bg-alt);
  }

  /* Stats */
  .stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .stat-item {
    text-align: center;
    padding: var(--space-md);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-light);
    box-shadow: var(--shadow-sm);
  }

  .stat-value {
    display: block;
    font-family: var(--font-serif);
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1.2;
    margin-bottom: 4px;
  }

  .stat-label {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }

  /* Timeline */
  .career-timeline {
    position: relative;
    padding-left: 28px;
    margin-bottom: var(--space-xl);
  }

  .career-timeline::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--color-border);
  }

  .timeline-item {
    position: relative;
    padding-bottom: var(--space-md);
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-dot {
    position: absolute;
    left: -24px;
    top: 6px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-surface);
    border: 2.5px solid var(--color-accent);
  }

  .timeline-item:first-child .timeline-dot {
    background: var(--color-accent);
  }

  .timeline-content {
    background: var(--color-surface);
    border-radius: var(--radius);
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--color-border-light);
  }

  .timeline-period {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .timeline-content h3 {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    margin: 2px 0 4px;
    color: var(--color-text);
  }

  .timeline-org {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    margin-bottom: 4px;
  }

  .timeline-highlight {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-style: italic;
  }

  /* Milestones */
  .milestones-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  .milestone-card {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    border: 1px solid var(--color-border-light);
    box-shadow: var(--shadow-sm);
    transition: all var(--transition);
  }

  .milestone-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .milestone-icon {
    font-size: 1.8rem;
    line-height: 1;
    display: block;
    margin-bottom: 8px;
  }

  .milestone-card h3 {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    margin-bottom: 6px;
    color: var(--color-text);
  }

  .milestone-card p {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .stats-row {
      grid-template-columns: repeat(2, 1fr);
    }

    .milestones-grid {
      grid-template-columns: 1fr;
    }

    .stat-value {
      font-size: 1.8rem;
    }
  }

  @media (max-width: 480px) {
    .stats-row {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-sm);
    }
  }
</style>
