---
import { t, type Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const stats = [
  {
    value: '15+',
    label: { en: 'Years of Experience', zh: '年技术经验' },
  },
  {
    value: '96',
    label: { en: 'AI Agent Skills', zh: '个 Agent 技能' },
  },
  {
    value: '8+',
    label: { en: 'Years in Enterprise Storage', zh: '年企业级存储测试' },
  },
  {
    value: '8',
    label: { en: 'BUs Unified on Test Strategy', zh: '个业务线统一测试策略' },
  },
];

const milestones = [
  {
    icon: '🌟',
    title: { en: 'Dell VP Star Award', zh: 'Dell VP 年度之星' },
    desc: {
      en: 'VP Star Award (2024) — led the strategy and execution of cross-BU integration testing for next-generation object storage across 8 BUs',
      zh: '2024 年 VP Star Award — 主导覆盖 8 个 BU 的下一代对象存储集成测试策略与落地执行',
    },
  },
  {
    icon: '🏆',
    title: { en: 'Dell Global Hackathon Top 10 Finalist', zh: 'Dell 全球黑客松 Top 10 Finalist' },
    desc: {
      en: 'Top 10 Finalist (2025) — AI-assisted test generation and coverage-optimization workflow',
      zh: '2025 年 Top 10 Finalist — AI 辅助测试生成与覆盖率优化工作流',
    },
  },
  {
    icon: '🎤',
    title: { en: 'QeCon Shanghai Speaker', zh: 'QeCon 上海大会演讲嘉宾' },
    desc: {
      en: 'Spoke at QeCon Shanghai on quality assurance practices for enterprise multi-cloud ECS/OBS systems',
      zh: '在 QeCon 上海大会分享企业级多云 ECS/OBS 质量保障实践',
    },
  },
  {
    icon: '🤖',
    title: { en: 'Enterprise AI Agent Platform Founder', zh: '企业级 AI Agent 平台发起者' },
    desc: {
      en: 'Founded and architected a 96-skill enterprise AI agent platform with Prompt-as-Orchestrator, structured evaluation, and automated quality guardrails.',
      zh: '发起并架构设计 96 技能的企业级 AI Agent 平台，采用 Prompt-as-Orchestrator、结构化评估与自动化质量门禁。',
    },
  },
];

const career = [
  {
    period: '2022.02 - 2026.07',
    role: { en: 'Senior Principal Software Engineer · AI Quality Engineering', zh: '高级主任软件工程师 · AI 质量工程' },
    org: { en: 'Dell Technologies (Dell EMC)', zh: '戴尔科技集团（Dell EMC）' },
    highlight: { en: 'Built a 96-skill AI agent platform; led integration-test strategy across 8 BUs; VP Star Award 2024; Global Hackathon 2025 Top 10 Finalist', zh: '建设 96 技能的 AI Agent 平台；牵头覆盖 8 个 BU 的集成测试策略；获 2024 VP Star Award、2025 全球黑客松 Top 10 Finalist' },
  },
  {
    period: '2021.01 - 2022.02',
    role: { en: 'R&D Lead', zh: '研发负责人' },
    org: { en: 'Banyu Music', zh: '伴鱼音乐' },
    highlight: { en: 'Owned design-to-launch delivery of an AI piano-practice app and established quality controls for non-deterministic recognition and scoring', zh: '负责 AI 钢琴练习 App 从设计到上线的端到端交付，并建立非确定性音频识别与评分输出的质量控制' },
  },
  {
    period: '2017.09 - 2021.01',
    role: { en: 'Senior Test Architect', zh: '高级测试架构师' },
    org: { en: 'Dell EMC', zh: 'Dell EMC' },
    highlight: { en: 'Built automation frameworks for global teams (US/China/India); regression cycle -40%', zh: '给中美印三地团队搭自动化框架，回归测试周期缩短 40%' },
  },
  {
    period: '2016.05 - 2017.09',
    role: { en: 'Director of QA & DevOps', zh: 'QA & DevOps 总监' },
    org: { en: 'Yunmanman (Manbang Group)', zh: '运满满（满帮集团）' },
    highlight: { en: 'Built the QA & DevOps function from zero to 40 people; production incidents fell 80% and deployment time fell 50%', zh: '从 0 组建至 40 人 QA & DevOps 团队；生产事故下降 80%，发布部署时间减少 50%' },
  },
  {
    period: '2010.06 - 2016.05',
    role: { en: 'QA Manager', zh: 'QA 经理' },
    org: { en: 'Dianping (Meituan)', zh: '大众点评（美团）' },
    highlight: { en: 'Led a 17-person QA team for transaction and payment systems on a platform serving 10M+ DAU; built an API automation framework that removed browser dependency from 90% of integration tests', zh: '带领 17 人 QA 团队保障交易与支付核心链路，所在平台 DAU 超千万；自研 API 自动化框架，使 90% 集成测试摆脱浏览器依赖' },
  },
  {
    period: '2009.03 - 2010.06',
    role: { en: 'Senior Test Engineer / Test Lead', zh: '高级测试工程师 / 测试主管' },
    org: { en: 'Giant Interactive Group', zh: '巨人网络' },
    highlight: { en: 'Introduced QTP/Selenium-IDE automation, reducing regression effort by 60%, and established LoadRunner peak-performance testing', zh: '引入 QTP/Selenium-IDE 自动化，使回归工作量下降 60%，并建立 LoadRunner 峰值性能测试能力' },
  },
];
---

<section class="achievements-section" id="achievements">
  <div class="container">
    <div class="section-header">
      <h2>{t(lang, 'achievements.title')}</h2>
      <div class="divider"></div>
      <p>{t(lang, 'achievements.subtitle')}</p>
    </div>

    <!-- Stats -->
    <div class="stats-row">
      {stats.map((s) => (
        <div class="stat-item">
          <span class="stat-value">{s.value}</span>
          <span class="stat-label">{s.label[lang]}</span>
        </div>
      ))}
    </div>

    <!-- Career Timeline -->
    <div class="career-timeline">
      {career.map((c, i) => (
        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            <span class="timeline-period">{c.period}</span>
            <h3>{c.role[lang]}</h3>
            <p class="timeline-org">{c.org[lang]}</p>
            <p class="timeline-highlight">{c.highlight[lang]}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Milestones -->
    <div class="milestones-grid">
      {milestones.map((m) => (
        <div class="milestone-card">
          <span class="milestone-icon">{m.icon}</span>
          <h3>{m.title[lang]}</h3>
          <p>{m.desc[lang]}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .achievements-section {
    background: var(--color-bg-alt);
  }

  /* Stats */
  .stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .stat-item {
    text-align: center;
    padding: var(--space-md);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-light);
    box-shadow: var(--shadow-sm);
  }

  .stat-value {
    display: block;
    font-family: var(--font-serif);
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1.2;
    margin-bottom: 4px;
  }

  .stat-label {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }

  /* Timeline */
  .career-timeline {
    position: relative;
    padding-left: 28px;
    margin-bottom: var(--space-xl);
  }

  .career-timeline::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--color-border);
  }

  .timeline-item {
    position: relative;
    padding-bottom: var(--space-md);
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-dot {
    position: absolute;
    left: -24px;
    top: 6px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-surface);
    border: 2.5px solid var(--color-accent);
  }

  .timeline-item:first-child .timeline-dot {
    background: var(--color-accent);
  }

  .timeline-content {
    background: var(--color-surface);
    border-radius: var(--radius);
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--color-border-light);
  }

  .timeline-period {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .timeline-content h3 {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    margin: 2px 0 4px;
    color: var(--color-text);
  }

  .timeline-org {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    margin-bottom: 4px;
  }

  .timeline-highlight {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-style: italic;
  }

  /* Milestones */
  .milestones-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  .milestone-card {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    border: 1px solid var(--color-border-light);
    box-shadow: var(--shadow-sm);
    transition: all var(--transition);
  }

  .milestone-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .milestone-icon {
    font-size: 1.8rem;
    line-height: 1;
    display: block;
    margin-bottom: 8px;
  }

  .milestone-card h3 {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    margin-bottom: 6px;
    color: var(--color-text);
  }

  .milestone-card p {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .stats-row {
      grid-template-columns: repeat(2, 1fr);
    }

    .milestones-grid {
      grid-template-columns: 1fr;
    }

    .stat-value {
      font-size: 1.8rem;
    }
  }

  @media (max-width: 480px) {
    .stats-row {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-sm);
    }
  }
</style>
