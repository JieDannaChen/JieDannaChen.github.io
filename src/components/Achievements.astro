---
import { t, type Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const stats = [
  {
    value: '15+',
    label: { en: 'Years of Experience', zh: '年技术经验' },
  },
  {
    value: '87',
    label: { en: 'AI Skills Built', zh: '个 AI 技能' },
  },
  {
    value: '200+',
    label: { en: 'Engineers Served', zh: '名工程师在用' },
  },
  {
    value: '8',
    label: { en: 'BUs Integrated', zh: '个业务线打通' },
  },
];

const milestones = [
  {
    icon: '🌟',
    title: { en: 'Dell VP Annual Star Award', zh: 'Dell VP 年度之星' },
    desc: {
      en: 'VP Star Award (2023) for cross-BU platform integration excellence — led technical integration across 8 business units for a converged storage appliance',
      zh: '2023 年拿到 VP 年度之星 — 带队打通了 8 个业务单元的融合存储平台集成',
    },
  },
  {
    icon: '🏆',
    title: { en: 'Dell Hackathon Champion', zh: 'Dell 黑客松冠军' },
    desc: {
      en: 'Dell Hackathon Champion (2025) — exceptional creativity and technical execution in company-wide innovation competition',
      zh: '2025 年拿下公司级黑客松冠军，创意和工程落地都被评委认可',
    },
  },
  {
    icon: '🎤',
    title: { en: 'QeCon Shanghai Speaker', zh: 'QeCon 上海大会讲师' },
    desc: {
      en: 'Delivered talk on Enterprise Platform Engineering Practices at QeCon Shanghai — China\'s premier software quality conference',
      zh: '在 QeCon 上海（国内顶级软件质量大会）做了「企业级平台工程实践」的主题演讲',
    },
  },
  {
    icon: '🤖',
    title: { en: 'Enterprise Agent Platform Architect', zh: '企业 Agent 平台总架构师' },
    desc: {
      en: 'Architected autonomous agent platform: 87 skills with tool-use (Jira, Jenkins, GitHub, Slack, etc.), persistent vector memory (SQLite + sentence-transformer), and weighted skill routing',
      zh: '从零搭起整个 Agent 平台：87 个技能打通 Jira、Jenkins、GitHub、Slack 等系统，带向量记忆和加权路由',
    },
  },
];

const career = [
  {
    period: '2009 – 2010',
    role: { en: 'Lead Engineer', zh: '主管工程师' },
    org: { en: 'Giant Interactive Group', zh: '巨人网络' },
    highlight: { en: 'SNS community platform & game portal, millions of DAU', zh: '做 SNS 社区和游戏门户，百万日活' },
  },
  {
    period: '2010 – 2016',
    role: { en: 'Engineering Manager', zh: '工程经理' },
    org: { en: 'Dianping.com (now Meituan)', zh: '大众点评（现美团）' },
    highlight: { en: '17-person team; transaction, merchant & payment systems; millions of DAU; API framework with 90% browser-free testing', zh: '带 17 人团队，管交易、商户和支付系统，百万日活；搞了一套 API 测试框架，90% 的测试不用开浏览器' },
  },
  {
    period: '2016 – 2017',
    role: { en: 'Engineering Director', zh: '工程总监' },
    org: { en: 'Full Truck Alliance / YMM (NYSE: YMM)', zh: '满帮集团 / 运满满（纽交所: YMM）' },
    highlight: { en: 'Built 40-person team from zero; incidents -80%; deploy 3hrs → 15min', zh: '从零拉起 40 人团队，线上事故降了 80%，发版从 3 小时压到 15 分钟' },
  },
  {
    period: '2017 – 2020',
    role: { en: 'Senior Architect', zh: '资深架构师' },
    org: { en: 'Dell EMC', zh: 'Dell EMC' },
    highlight: { en: 'Built automation frameworks for global teams (US/China/India); regression cycle -40%', zh: '给中美印三地团队搭自动化框架，回归测试周期缩短 40%' },
  },
  {
    period: '2020 – 2022',
    role: { en: 'Head of Engineering', zh: '研发负责人' },
    org: { en: 'Banyumusic (Series A, SIG-led)', zh: '伴鱼音乐（A 轮，SIG 领投）' },
    highlight: { en: 'Led R&D team; drove AI piano coaching product from design to launch; competitive analysis & risk control', zh: '搭团队、带研发，把 AI 钢琴陪练产品从方案推到上线，也管竞品分析和风险把控' },
  },
  {
    period: '2022 – Present',
    role: { en: 'Senior Principal Engineer', zh: '资深首席工程师' },
    org: { en: 'Dell Technologies', zh: 'Dell Technologies' },
    highlight: { en: 'Autonomous agent platform (87 skills, tool-use, vector memory); cross-BU lead (8 BUs); VP Star Award; Hackathon Champion', zh: '搭建 87 技能的 Agent 平台（工具调用 + 向量记忆），牵头 8 个业务线集成，VP 年度之星 + 黑客松冠军' },
  },
];
---

<section class="achievements-section" id="achievements">
  <div class="container">
    <div class="section-header">
      <h2>{t(lang, 'achievements.title')}</h2>
      <div class="divider"></div>
      <p>{t(lang, 'achievements.subtitle')}</p>
    </div>

    <!-- Stats -->
    <div class="stats-row">
      {stats.map((s) => (
        <div class="stat-item">
          <span class="stat-value">{s.value}</span>
          <span class="stat-label">{s.label[lang]}</span>
        </div>
      ))}
    </div>

    <!-- Career Timeline -->
    <div class="career-timeline">
      {career.map((c, i) => (
        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            <span class="timeline-period">{c.period}</span>
            <h3>{c.role[lang]}</h3>
            <p class="timeline-org">{c.org[lang]}</p>
            <p class="timeline-highlight">{c.highlight[lang]}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Milestones -->
    <div class="milestones-grid">
      {milestones.map((m) => (
        <div class="milestone-card">
          <span class="milestone-icon">{m.icon}</span>
          <h3>{m.title[lang]}</h3>
          <p>{m.desc[lang]}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .achievements-section {
    background: var(--color-bg-alt);
  }

  /* Stats */
  .stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .stat-item {
    text-align: center;
    padding: var(--space-md);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-light);
    box-shadow: var(--shadow-sm);
  }

  .stat-value {
    display: block;
    font-family: var(--font-serif);
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1.2;
    margin-bottom: 4px;
  }

  .stat-label {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }

  /* Timeline */
  .career-timeline {
    position: relative;
    padding-left: 28px;
    margin-bottom: var(--space-xl);
  }

  .career-timeline::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--color-border);
  }

  .timeline-item {
    position: relative;
    padding-bottom: var(--space-md);
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-dot {
    position: absolute;
    left: -24px;
    top: 6px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-surface);
    border: 2.5px solid var(--color-accent);
  }

  .timeline-item:last-child .timeline-dot {
    background: var(--color-accent);
  }

  .timeline-content {
    background: var(--color-surface);
    border-radius: var(--radius);
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--color-border-light);
  }

  .timeline-period {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .timeline-content h3 {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    margin: 2px 0 4px;
    color: var(--color-text);
  }

  .timeline-org {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    margin-bottom: 4px;
  }

  .timeline-highlight {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-style: italic;
  }

  /* Milestones */
  .milestones-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  .milestone-card {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    border: 1px solid var(--color-border-light);
    box-shadow: var(--shadow-sm);
    transition: all var(--transition);
  }

  .milestone-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .milestone-icon {
    font-size: 1.8rem;
    line-height: 1;
    display: block;
    margin-bottom: 8px;
  }

  .milestone-card h3 {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    margin-bottom: 6px;
    color: var(--color-text);
  }

  .milestone-card p {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .stats-row {
      grid-template-columns: repeat(2, 1fr);
    }

    .milestones-grid {
      grid-template-columns: 1fr;
    }

    .stat-value {
      font-size: 1.8rem;
    }
  }

  @media (max-width: 480px) {
    .stats-row {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-sm);
    }
  }
</style>
