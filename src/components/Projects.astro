---
import { t, type Lang } from '../i18n/translations';
import { projects } from '../data/projects';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const icons = ['📊', '🌪️', '🌐'];
---

<section class="projects-section" id="projects">
  <div class="container">
    <div class="section-header">
      <h2>{t(lang, 'projects.title')}</h2>
      <div class="divider"></div>
      <p>{t(lang, 'projects.subtitle')}</p>
    </div>

    <div class="projects-list">
      {projects.map((project, i) => (
        <article class="project-card">
          <div class="project-image">
            <div class="project-image-placeholder" data-index={i}>
              <span class="placeholder-icon">{icons[i]}</span>
            </div>
          </div>
          <div class="project-info">
            <h3>{project.title[lang]}</h3>
            <p class="project-desc">{project.description[lang]}</p>
            {project.impact && (
              <div class="project-impact">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="23 6 13.5 15.5 8.5 10.5 1 18" />
                  <polyline points="17 6 23 6 23 12" />
                </svg>
                <span>{project.impact[lang]}</span>
              </div>
            )}
            <div class="project-tags">
              {project.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .projects-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .project-card {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: var(--space-md);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border-light);
    box-shadow: var(--shadow-sm);
    transition: all var(--transition);
  }

  .project-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }

  .project-card:nth-child(even) {
    direction: rtl;
  }

  .project-card:nth-child(even) > * {
    direction: ltr;
  }

  .project-image {
    height: 100%;
    min-height: 240px;
  }

  .project-image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3.5rem;
  }

  .project-image-placeholder[data-index="0"] {
    background: linear-gradient(135deg, #e8efe6 0%, #d4e4cf 100%);
  }
  .project-image-placeholder[data-index="1"] {
    background: linear-gradient(135deg, #e6edf4 0%, #cfd9e8 100%);
  }
  .project-image-placeholder[data-index="2"] {
    background: linear-gradient(135deg, #f0ebe4 0%, #e2d8cb 100%);
  }

  .project-info {
    padding: var(--space-md) var(--space-md) var(--space-md) 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .project-card:nth-child(even) .project-info {
    padding: var(--space-md) 0 var(--space-md) var(--space-md);
  }

  .project-info h3 {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    margin-bottom: var(--space-xs);
    color: var(--color-text);
  }

  .project-desc {
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: var(--space-sm);
    color: var(--color-text-secondary);
    max-width: none;
  }

  .project-impact {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background: var(--color-accent-light);
    border-radius: var(--radius);
    margin-bottom: var(--space-sm);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent);
    line-height: 1.4;
  }

  .project-impact svg {
    flex-shrink: 0;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tag {
    font-size: 0.78rem;
    font-weight: 500;
    padding: 3px 10px;
    background: var(--color-bg);
    border: 1px solid var(--color-border-light);
    color: var(--color-text-muted);
    border-radius: 12px;
    letter-spacing: 0.02em;
  }

  @media (max-width: 768px) {
    .project-card {
      grid-template-columns: 1fr;
    }

    .project-card:nth-child(even) {
      direction: ltr;
    }

    .project-image {
      min-height: 180px;
    }

    .project-info,
    .project-card:nth-child(even) .project-info {
      padding: 0 var(--space-md) var(--space-md) var(--space-md);
    }
  }
</style>
