---
import { t, type Lang } from '../i18n/translations';
import { projects } from '../data/projects';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// 每个项目对应一个语义化 SVG 图标（内联，避免依赖外部资源）
const icons = [
  // Coverage Robot — 齿轮+箭头（自动化闭环）
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/><circle cx="12" cy="12" r="4"/></svg>',
  // AI Quality Kit — 盾牌打勾（质量保障）
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>',
  // Agent Harness — 框架/结构（治理）
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 14h7v7h-7z"/></svg>',
  // vLLM Benchmark — 闪电（性能）
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>',
  // Skill Kit — 层叠卡片（管理）
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="14" height="14" rx="2"/><path d="M7 7h14v14H7"/></svg>',
  // AI Job Hunter — 罗盘（导航/匹配）
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>',
  // Marathon Copilot — 跑步
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="13" cy="4" r="2"/><path d="M9 20l3-6 3 4 3-1M6 13l3-3 4 2 2-3"/></svg>',
];

// Keep the NVIDIA-relevant projects first while retaining each project's icon.
const projectOrder = [0, 1, 3, 2, 4, 5, 6];
const displayedProjects = projectOrder.map((projectIndex) => ({
  project: projects[projectIndex],
  icon: icons[projectIndex],
}));
---

<section class="projects-section" id="projects">
  <div class="container">
    <div class="section-header">
      <h2>{t(lang, 'projects.title')}</h2>
      <div class="divider"></div>
      <p>{t(lang, 'projects.subtitle')}</p>
    </div>

    <div class="projects-list">
      {displayedProjects.map(({ project, icon }, i) => (
        <article class="project-card">
          <div class="project-image">
            <div class="project-image-placeholder" data-index={i}>
              <span class="placeholder-icon" set:html={icon} />
            </div>
          </div>
          <div class="project-info">
            <h3>{project.title[lang]}</h3>
            <p class="project-desc">{project.description[lang]}</p>
            {project.impact && (
              <div class="project-impact">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="23 6 13.5 15.5 8.5 10.5 1 18" />
                  <polyline points="17 6 23 6 23 12" />
                </svg>
                <span>{project.impact[lang]}</span>
              </div>
            )}
            <div class="project-bottom">
              <div class="project-tags">
                {project.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
              {project.github && (
                <a href={project.github} target="_blank" rel="noopener" class="github-link">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
                  </svg>
                  {t(lang, 'projects.viewCode')}
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .projects-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .project-card {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: var(--space-md);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border-light);
    box-shadow: var(--shadow-sm);
    transition: all var(--transition);
  }

  .project-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }

  .project-card:nth-child(even) {
    direction: rtl;
  }

  .project-card:nth-child(even) > * {
    direction: ltr;
  }

  .project-image {
    height: 100%;
    min-height: 140px;
  }

  .project-image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .placeholder-icon {
    width: 44px;
    height: 44px;
    color: var(--color-accent);
    opacity: 0.85;
    transition: all var(--transition);
  }

  .placeholder-icon svg {
    width: 100%;
    height: 100%;
  }

  .project-card:hover .placeholder-icon {
    opacity: 1;
    transform: scale(1.1);
  }

  .project-image-placeholder[data-index="0"] {
    background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%);
  }
  .project-image-placeholder[data-index="1"] {
    background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
  }
  .project-image-placeholder[data-index="2"] {
    background: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 100%);
  }
  .project-image-placeholder[data-index="3"] {
    background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
  }
  .project-image-placeholder[data-index="4"] {
    background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%);
  }
  .project-image-placeholder[data-index="5"] {
    background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
  }
  .project-image-placeholder[data-index="6"] {
    background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
  }

  .project-info {
    padding: var(--space-md) var(--space-md) var(--space-md) 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .project-card:nth-child(even) .project-info {
    padding: var(--space-md) 0 var(--space-md) var(--space-md);
  }

  .project-info h3 {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    margin-bottom: var(--space-xs);
    color: var(--color-text);
  }

  .project-desc {
    font-size: 0.93rem;
    line-height: 1.7;
    margin-bottom: var(--space-sm);
    color: var(--color-text-secondary);
    max-width: none;
  }

  .project-impact {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background: var(--color-accent-light);
    border-radius: var(--radius);
    margin-bottom: var(--space-sm);
    font-size: 0.83rem;
    font-weight: 600;
    color: var(--color-accent);
    line-height: 1.4;
  }

  .project-impact svg {
    flex-shrink: 0;
  }

  .project-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tag {
    font-size: 0.76rem;
    font-weight: 500;
    padding: 3px 10px;
    background: var(--color-bg);
    border: 1px solid var(--color-border-light);
    color: var(--color-text-muted);
    border-radius: 12px;
    letter-spacing: 0.02em;
  }

  .github-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    padding: 6px 14px;
    border: 1px solid var(--color-border);
    border-radius: 20px;
    transition: all var(--transition);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .github-link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: var(--color-accent-light);
  }

  @media (max-width: 768px) {
    .project-card {
      grid-template-columns: 1fr;
    }

    .project-card:nth-child(even) {
      direction: ltr;
    }

    .project-image {
      min-height: 100px;
    }

    .project-image-placeholder {
      padding: var(--space-sm) 0;
    }

    .placeholder-icon {
      width: 36px;
      height: 36px;
    }

    .project-info,
    .project-card:nth-child(even) .project-info {
      padding: 0 var(--space-md) var(--space-md) var(--space-md);
    }
  }
</style>
