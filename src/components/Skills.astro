---
import { t, type Lang } from '../i18n/translations';
import { skills, interests } from '../data/skills';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const categories = [
  { key: 'ai', label: { en: 'AI & Agent', zh: 'AI / Agent' } },
  { key: 'testing', label: { en: 'Testing & Quality', zh: '测试与质量' } },
  { key: 'infra', label: { en: 'Infrastructure', zh: '基础设施' } },
  { key: 'language', label: { en: 'Languages', zh: '编程语言' } },
] as const;
---

<section class="skills-section" id="skills">
  <div class="container">
    <div class="section-header">
      <h2>{t(lang, 'skills.title')}</h2>
      <div class="divider"></div>
      <p>{t(lang, 'skills.subtitle')}</p>
    </div>

    <div class="skills-grid">
      <!-- Left: Core Focus (formerly interests) - primary emphasis -->
      <div class="focus-card">
        <h3>{t(lang, 'skills.focus')}</h3>
        <div class="focus-list">
          {interests.map((item) => (
            <div class="focus-item">
              <span class="focus-icon">{item.icon}</span>
              <div>
                <strong>{item.name[lang]}</strong>
                <p>{item.description[lang]}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: Technical Skills - supporting details -->
      <div class="tech-card">
        <h3>{t(lang, 'skills.technical')}</h3>
        {categories.map((cat) => (
          <div class="skill-category">
            <span class="category-label">{cat.label[lang]}</span>
            <div class="skill-tags">
              {skills
                .filter((s) => s.category === cat.key)
                .map((skill) => (
                  <span class="skill-tag">
                    <span class="skill-icon">{skill.icon}</span>
                    {skill.name}
                  </span>
                ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .skills-section {
    background: var(--color-bg-alt);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-md);
    align-items: start;
  }

  .focus-card,
  .tech-card {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: var(--space-lg) var(--space-md);
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-border-light);
  }

  .focus-card h3,
  .tech-card h3 {
    font-family: var(--font-serif);
    margin-bottom: var(--space-md);
    color: var(--color-text);
  }

  .focus-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .focus-item {
    display: flex;
    gap: var(--space-sm);
    align-items: flex-start;
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-border-light);
  }

  .focus-item:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  .focus-icon {
    font-size: 1.8rem;
    line-height: 1;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .focus-item strong {
    display: block;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 4px;
  }

  .focus-item p {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .skill-category {
    margin-bottom: var(--space-md);
  }

  .skill-category:last-child {
    margin-bottom: 0;
  }

  .category-label {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-xs);
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .skill-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    background: var(--color-bg);
    border: 1px solid var(--color-border-light);
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    transition: all var(--transition);
  }

  .skill-tag:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    transform: translateY(-1px);
  }

  .skill-icon {
    font-size: 0.95rem;
    line-height: 1;
  }

  @media (max-width: 768px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
